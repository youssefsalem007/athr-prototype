# Base URL the client uses to call the API.
# In dev, leave empty to use the Vite proxy (/api -> http://localhost:4000).
VITE_API_BASE_URL=

# Optional: override the proxy target used by vite.config.js
VITE_API_PROXY=http://localhost:4000

# Free shipping threshold shown in the announcement bar / cart progress.
# The server value (GET /api/config) takes precedence once loaded.
VITE_FREE_SHIPPING_THRESHOLD=1500
