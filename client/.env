# ATHR client — read by Vite at build/dev time.
# NOTE: committed on purpose; this prototype uses fake/sample data only.
# Empty VITE_API_BASE_URL -> the app uses relative /api
# (Vite proxy in dev, Vercel rewrite to the serverless API in production).
VITE_API_BASE_URL=
VITE_FREE_SHIPPING_THRESHOLD=1500
